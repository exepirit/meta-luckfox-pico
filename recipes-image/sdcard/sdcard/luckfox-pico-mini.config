image @IMAGE@ {
  hdimage {
    partition-table-type = none
  }
  partition env {
    image = env.img
    offset = 0
    in-partition-table = false
  }
  partition idblock {
    image = idblock.img
    offset = 32k
    in-partition-table = false
  }
  partition uboot {
    image = uboot.img
    offset = 544k
    in-partition-table = false
  }
  partition boot {
    image = boot.img
    offset = 800k
    in-partition-table = false
  }
  partition rootfs {
    image = "core-image-minimal-@MACHINE@.rootfs.ext4"
    offset = 33568k
    in-partition-table = false
  }
}